          "title": "EPIPEN : <span style=\"white-space:nowrap\">SAVEZ-VOUS</span> UTILISER UN AUTO-INJECTEUR D'ÉPINÉPHRINE ?",
          "header_size": "h3",
          "title_color": "#0E1B33",
          "typography_typography": "custom",
